# Copy to .env for local overrides. Never commit the real .env file.

# Django
DJANGO_SETTINGS_MODULE=AutomaticStockTrading.settings.dev
SECRET_KEY=change-me-to-a-real-random-secret-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - omit to fall back to a local sqlite file in dev.
# DATABASE_URL=postgres://trading:trading@localhost:5432/trading

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
