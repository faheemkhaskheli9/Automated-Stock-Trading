# Copy to .env for local overrides. Never commit the real .env file.

# Django
DJANGO_SETTINGS_MODULE=AutomaticStockTrading.settings.dev
SECRET_KEY=change-me-to-a-real-random-secret-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - omit to fall back to a local sqlite file in dev.
# DATABASE_URL=postgres://trading:trading@localhost:5432/trading

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# modeling app - directory trained model artifacts are written to.
# Omit to use <repo>/artifacts/models (gitignored).
# MODEL_ARTIFACT_DIR=/var/lib/trading/model-artifacts

# Alerting (order fills/rejections/risk breaches) - both optional, see
# execution/notifications.py. With neither set, alerts are just logged.
# ADMIN_EMAILS=you@example.com,ops@example.com
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# DEFAULT_FROM_EMAIL=alerts@example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
